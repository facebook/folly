# @fb-only[end= ]: load("@fbcode//gdb/scripts/tests/common:gdb_unittest.bzl", "gdb_unittest")
load("@fbsource//tools/build_defs/dirsync:fb_dirsync_cpp_binary.bzl", "fb_dirsync_cpp_binary")
load("@fbsource//tools/build_defs/dirsync:fb_dirsync_cpp_library.bzl", "fb_dirsync_cpp_library")
load("@fbsource//tools/build_defs/dirsync:fb_dirsync_rule.bzl", "fb_dirsync_rule")

oncall("fbcode_entropy_wardens_folly")

fb_dirsync_cpp_library(
    name = "gdb_util",
    headers = ["GdbUtil.h"],
    exported_deps = [
        "//folly:c_portability",
    ],
)

fb_dirsync_cpp_binary(
    name = "main",
    srcs = ["main.cpp"],
    compiler_flags = [
        "-fno-debug-types-section",
        "-fstandalone-debug",
        "-g",
        "-gdwarf-4",
        "-gno-simple-template-names",
        "-gno-split-dwarf",
    ],
    default_strip_mode = "none",
    modules = False,
    deps = [
        ":gdb_util",
        "//folly:network_address",
        "//folly:range",
        "//folly:small_vector",
        "//folly/container:f14_hash",
        "//folly/json:dynamic",
    ],
)

