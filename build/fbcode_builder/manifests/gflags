[manifest]
name = gflags

[download]
url = https://github.com/gflags/gflags/archive/refs/tags/v2.3.0.tar.gz
sha256 = f619a51371f41c0ad6837b2a98af9d4643b3371015d873887f7e8d3237320b2f

[build]
builder = cmake
subdir = gflags-2.3.0

[cmake.defines]
BUILD_SHARED_LIBS = ON
BUILD_STATIC_LIBS = ON
BUILD_gflags_LIB = ON

[homebrew]
gflags

[debs]
libgflags-dev

# EPEL 10 ships this too; EL 8 and 9 do not have a usable version.
[rpms.any(distro=fedora,all(distro_family=rhel,not(any(distro_vers=8,distro_vers=9))))]
gflags-devel
