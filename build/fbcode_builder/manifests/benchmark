[manifest]
name = benchmark

[download]
url = https://github.com/google/benchmark/archive/refs/tags/v1.9.5.tar.gz
sha256 = 9631341c82bac4a288bef951f8b26b41f69021794184ece969f8473977eaa340

[build]
builder = cmake
subdir = benchmark-1.9.5/

[cmake.defines]
BENCHMARK_ENABLE_TESTING=OFF

# EPEL 10 ships this too; EL 8 and 9 do not have a usable version.
[rpms.any(distro=fedora,all(distro_family=rhel,not(any(distro_vers=8,distro_vers=9))))]
google-benchmark-devel
