[manifest]
name = benchmark

[download]
url = https://github.com/google/benchmark/archive/refs/tags/v1.8.0.tar.gz
sha256 = ea2e94c24ddf6594d15c711c06ccd4486434d9cf3eca954e2af8a20c88f9f172

[build]
builder = cmake
subdir = benchmark-1.8.0/

[cmake.defines]
BENCHMARK_ENABLE_TESTING=OFF

# EPEL 10 ships this too; EL 8 and 9 do not have a usable version.
[rpms.any(distro=fedora,all(distro_family=rhel,not(any(distro_vers=8,distro_vers=9))))]
google-benchmark-devel
