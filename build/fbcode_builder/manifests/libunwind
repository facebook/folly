[manifest]
name = libunwind

[rpms]
libunwind-devel
libunwind

# on ubuntu this brings in liblzma-dev, which in turn breaks watchman tests
[debs.not(distro=ubuntu)]
libunwind-dev

# libunwind before v1.8.2 release has compiler issues with aarch64 (https://github.com/libunwind/libunwind/issues/702).
[download]
url = https://github.com/libunwind/libunwind/releases/download/v1.8.3/libunwind-1.8.3.tar.gz
sha256 = be30d910e67f58d82e753231f1357f326a1a088acf126b21ff77e60aab19b90b

[build]
builder = autoconf
subdir = libunwind-1.8.3

[autoconf.args]
--with-pic
--disable-zlibdebuginfo
--disable-minidebuginfo
